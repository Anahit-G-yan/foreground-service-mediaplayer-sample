<resources>
    <!-- Shown by the system while the process starts; androidx.core.splashscreen makes this
         work uniformly back to minSdk instead of only on Android 12+. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.MusicPlayer.NoActionBar</item>
    </style>
</resources>
