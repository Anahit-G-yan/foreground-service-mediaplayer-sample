<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <RelativeLayout
        android:id="@+id/favoriteIconContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp">

        <ImageView
            android:id="@+id/favoriteIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:src="@drawable/favorite"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/favoritedIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="15dp"
            android:src="@drawable/heart"
            android:visibility="gone"
            android:contentDescription="@null" />

    </RelativeLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/thumbnailImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:backgroundTint="@color/white"
        android:scaleType="center"
        app:shapeAppearance="@style/ShapeAppearance.Player.Circle"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/thumbnailImage"
        android:layout_margin="15dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="15sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/positionSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/repeatOffIcon"
                android:src="@drawable/loop"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/repeatOneIcon"
                android:src="@drawable/next_music"
                android:visibility="gone"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/positionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textColor="@color/white" />

            <ImageView
                android:id="@+id/prevButton"
                android:src="@drawable/back_music"
                android:layout_below="@+id/positionText"
                android:layout_marginTop="10dp"
                android:layout_toStartOf="@+id/playPauseButton"
                android:layout_marginEnd="30dp"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/playPauseButton"
                android:src="@drawable/pause"
                android:layout_centerInParent="true"
                android:layout_marginTop="10dp"
                android:layout_below="@+id/positionText"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/nextButton"
                android:layout_marginTop="10dp"
                android:src="@drawable/back_music"
                android:rotation="180"
                android:layout_toEndOf="@+id/playPauseButton"
                android:layout_marginStart="30dp"
                android:layout_below="@+id/positionText"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@null" />

        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
